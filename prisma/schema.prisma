generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  STAFF
}

model AdminUser {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String
  passwordHash             String
  role                     AdminRole @default(STAFF)
  jobTitle                 String?
  hourlyRate               Int       @default(0)
  passwordResetTokenHash   String?   @unique
  passwordResetExpiresAt   DateTime?
  passwordResetRequestedAt DateTime?
  createdAt                DateTime  @default(now())
  broadcasts               Broadcast[]
  productionSessions       ProductionSession[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  category    String
  description String?
  basePrice   Int
  colors      Json
  sizes       Json
  images      Json
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  designs    Design[]
  orderItems OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  orders   Order[]
  designs  Design[]
  quotes   Quote[]
  invoices Invoice[]
}

model Design {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  color        String
  canvasData   Json
  previewImage String?
  createdAt    DateTime @default(now())
  orderItems OrderItem[]
  quotes     Quote[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  WIPAY
  FYGARO
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String          @id @default(cuid())
  orderNumber      String          @unique
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  customerEmail    String
  customerName     String
  customerPhone    String?
  shippingAddress  String?
  notes            String?
  status           OrderStatus     @default(PENDING_PAYMENT)
  paymentProvider  PaymentProvider?
  paymentStatus    PaymentStatus   @default(UNPAID)
  paymentReference String?
  subtotal         Int
  total            Int
  currency         String          @default("JMD")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items      OrderItem[]
  workOrders WorkOrder[]
  invoices   Invoice[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  designId   String?
  design     Design?  @relation(fields: [designId], references: [id])
  size       String
  color      String
  quantity   Int
  unitPrice  Int
  lineTotal  Int
}

enum WorkOrderStage {
  SUBMITTED
  REVIEW
  NEEDS_CUSTOMER_APPROVAL
  APPROVED
  QUEUED
  IN_PROGRESS
  QUALITY_CHECK
  READY
  COMPLETED
  ON_HOLD
  CANCELLED
}

model WorkOrder {
  id               String         @id @default(cuid())
  workOrderNumber  String         @unique
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            WorkOrderStage @default(SUBMITTED)
  priority         String         @default("NORMAL")
  productionMethod String?
  productionPhase  String         @default("PRE_PRESS")
  placement        String?
  assignedTo       String?
  machine          String?
  progress         Int            @default(0)
  lastWorkedBy     String?
  startedAt        DateTime?
  completedAt      DateTime?
  dueDate          DateTime?
  blockedReason    String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  events           WorkOrderEvent[]
  sessions         ProductionSession[]
}

model WorkOrderEvent {
  id          String         @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStage   WorkOrderStage?
  toStage     WorkOrderStage
  note        String?
  changedBy   String?
  createdAt   DateTime       @default(now())
}

model ProductionSession {
  id              String    @id @default(cuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  staffId         String
  staff           AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([workOrderId, startedAt])
  @@index([staffId, startedAt])
  @@index([active])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  vendorName  String
  vendorEmail String?
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  total       Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int
  unitCost        Int
  lineTotal       Int
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model Broadcast {
  id          String    @id @default(cuid())
  subject     String
  body        String
  sentAt      DateTime?
  sentCount   Int       @default(0)
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}


enum QuoteStatus {
  REQUESTED
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  CANCELLED
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  designId         String?
  design           Design?     @relation(fields: [designId], references: [id], onDelete: SetNull)
  source           String      @default("WEB")
  status           QuoteStatus @default(REQUESTED)
  customerName     String
  customerEmail    String
  customerPhone    String?
  company          String?
  jobType          String
  details          String
  artworkUrl       String?
  budget           String?
  issueDate        DateTime    @default(now())
  validUntil       DateTime?
  subtotal         Int         @default(0)
  tax              Int         @default(0)
  total            Int         @default(0)
  currency         String      @default("JMD")
  notes            String?
  convertedOrderId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]
  invoices         Invoice[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Int    @default(0)
  lineTotal   Int    @default(0)
  sortOrder   Int    @default(0)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Int           @default(0)
  tax           Int           @default(0)
  total         Int           @default(0)
  amountPaid    Int           @default(0)
  balance       Int           @default(0)
  currency      String        @default("JMD")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]

  @@index([status, dueDate])
  @@index([customerId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)
  sortOrder   Int     @default(0)
}
